# Reuse the document's precompiled preamble for every pdflatex pass.
$pdflatex = 'pdflatex -fmt=distributed-systems %O %S';

# imakeidx is configured with noautomatic so latexmk owns this dependency and
# only rebuilds the index after the .idx input changes.
$makeindex = 'makeindex -s index-style.ist %O -o %D %S';
